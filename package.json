{
  "name": "free-api-news",
  "version": "1.0.0",
  "description": "無料LLM API速報 — 毎日更新される無料・割引API情報サイト",
  "scripts": {
    "validate": "node build/validate-report.js report.json .agents/skills/llm-deals-intelligence-skill/schemas/daily_report.schema.json",
    "build": "node build/build-html.js report.json dist/index.html && node build/build-og-image.js report.json dist/og-image.html dist/og-image.png",
    "build:og": "node build/build-og-image.js report.json dist/og-image.html dist/og-image.png",
    "promote:dist": "node build/promote-dist.js",
    "collect": "node .devops/db/cli.js collect",
    "collect:dry-run": "node .devops/db/cli.js collect --dry-run",
    "deploy": "node .devops/db/cli.js deploy",
    "full": "node .devops/db/cli.js collect --push",
    "db:migrate": "node .devops/db/cli.js migrate",
    "db:status": "node .devops/db/cli.js status",
    "set-hidden": "node .devops/db/cli.js set-hidden",
    "watch:list": "node .devops/db/cli.js watch:list",
    "watch:add": "node .devops/db/cli.js watch:add",
    "watch:remove": "node .devops/db/cli.js watch:remove",
    "db:bootstrap": "node .devops/db/cli.js bootstrap",
    "db:import-legacy": "node .devops/db/cli.js import-legacy",
    "db:restore": "node .devops/db/cli.js restore",
    "validate-candidate": "node .devops/db/cli.js validate-candidate",
    "promote": "node .devops/db/cli.js promote",
    "recover": "node .devops/db/cli.js recover",
    "cleanup": "node .devops/db/cli.js cleanup",
    "test": "node --test '.devops/db/*.test.js' 'build/*.test.js'"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
