{
  "name": "free-api-news",
  "version": "1.0.0",
  "description": "無料LLM API速報 — 毎日更新される無料・割引API情報サイト",
  "scripts": {
    "validate": "node build/validate-report.js report.json .agents/skills/llm-deals-intelligence-skill/schemas/daily_report.schema.json",
    "build": "node build/build-html.js report.json index.html",
    "collect": ".devops/batch/run-skill.sh",
    "deploy": ".devops/deploy/git-push.sh",
    "full": "npm run collect && npm run validate && npm run build && npm run deploy"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
