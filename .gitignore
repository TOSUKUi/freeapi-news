# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
.devops/logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# pi runtime state
.pi/
.pi-subagents/
.agents/cache/

# AI workflow skills are local tooling, not project source.
# Track only the domain collection skill and the lock-pinned shadcn skill.
.agents/skills/*
!.agents/skills/llm-deals-intelligence-skill/
!.agents/skills/shadcn/

# Workflow management docs (specs, scope, verify) are not tracked.
docs/

# Redundant archive (the unpacked skill lives in .agents/skills/)
llm-deals-intelligence-skill.zip

# OGP image: the rendered PNG is a tracked, served artifact (like index.html);
# the intermediate HTML used only to rasterize it is not.
og-image.html

# Collector operational state (spec 0003): local only, never tracked.
# SQLite is the sole operational state after cutover. The whole skill state
# directory is local: the database and its journal sidecars, the per run
# directories (manifest, task artifacts, candidate files, DB copies, promotion
# manifests, logs), and the retired legacy JSON state. Git tracks only the
# public report.json, generated index.html and og-image.png, and the human
# managed build/provider-registry.json.
.agents/skills/llm-deals-intelligence-skill/state/
.devops/batch/.crawl.lock

# Generated build output (canonical files are tracked, dist/ is not)
dist/
