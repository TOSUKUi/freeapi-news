{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Raw facts emitted by known_refresh/discovery workers. Candidate registration and discovery source claims are proposals; deterministic HTTP evidence auditing must accept them before reduction.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status",
    "crawled_at",
    "provider_key",
    "models",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "number"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "crawled_at": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id"
        ],
        "properties": {
          "provider_key": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "model_name": {
            "type": "string"
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_label": {
            "type": "string"
          },
          "docs_url": {
            "type": "string"
          },
          "endpoint_source": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "free_quota_text": {
            "type": "string"
          },
          "pricing_text": {
            "type": "string"
          },
          "params_text": {
            "type": "string"
          },
          "is_free_signal": {
            "type": "boolean"
          },
          "offer_ended": {
            "type": "boolean"
          },
          "source_amount_input": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_amount_output": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_unit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "per_token",
              "per_million_tokens",
              "",
              null
            ]
          },
          "conversion_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "conversion_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "conversion_confirmed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "discount_start_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "discount_end_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "benchmark_finds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "score"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "source_url": {
                  "type": "string"
                },
                "body_excerpt": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "normal_source_amount_input": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "normal_source_amount_output": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "normal_source_amount_cache_read": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "normal_source_amount_cache_write": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "effective_source_amount_input": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "effective_source_amount_output": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "effective_source_amount_cache_read": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "effective_source_amount_cache_write": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "required": ["discount_start_at"] },
                { "required": ["discount_end_at"] }
              ]
            },
            "then": {
              "required": ["discount_start_at", "discount_end_at"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "source_url",
          "reason"
        ],
        "properties": {
          "model_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "source_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "label",
          "source_url",
          "provider_key",
          "model_id"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "parent_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "provider_key": {
            "type": "string"
          },
          "provider_label": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "fact_text": {
            "type": "string"
          },
          "pricing_text": {
            "type": "string"
          },
          "benchmark_name": {
            "type": "string"
          },
          "benchmark_version": {
            "type": "string"
          },
          "benchmark_score": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "provider_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider_key",
          "label",
          "base_url",
          "docs_url",
          "model_id_pattern",
          "model_id_example"
        ],
        "properties": {
          "provider_key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "docs_url": {
            "type": "string"
          },
          "model_id_pattern": {
            "type": "string"
          },
          "model_id_example": {
            "type": "string"
          },
          "delivery_type": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
