{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM Deals Daily Report",
  "type": "object",
  "required": [
    "generated_at",
    "timezone",
    "new_models",
    "changes",
    "ranked_offers",
    "excluded_offers",
    "sources"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "new_models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelDiscovery"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeRecord"
      }
    },
    "ranked_offers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offer"
      }
    },
    "conditional_credits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offer"
      }
    },
    "caution_offers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offer"
      }
    },
    "excluded_offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "last_known_status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "new_seed_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "recommend_add"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "recommend_add": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "source_type"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_type": {
            "enum": [
              "official",
              "provider",
              "github",
              "reddit",
              "news",
              "community",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "modelDiscovery": {
      "type": "object",
      "required": [
        "canonical_name",
        "vendor",
        "status",
        "official_source"
      ],
      "properties": {
        "canonical_name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vendor": {
          "type": "string"
        },
        "status": {
          "enum": [
            "announced",
            "preview",
            "beta",
            "ga",
            "open_weight_planned",
            "deprecated"
          ]
        },
        "release_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "official_source": {
          "type": "string",
          "format": "uri"
        },
        "api_available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "open_weight": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "known_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "window": {
          "type": "string",
          "enum": [
            "hot",
            "warm",
            "catchup",
            "undated"
          ],
          "$comment": "spec 0008: recency tag from release_date (hot 24h / warm 72h / catchup 30d)"
        },
        "distribution_note": {
          "type": "string",
          "$comment": "spec 0008: model fan out route verdicts summary (served / not_served / unconfirmed per provider)"
        }
      },
      "additionalProperties": false
    },
    "changeRecord": {
      "type": "object",
      "required": [
        "offer_name",
        "change_type",
        "summary"
      ],
      "properties": {
        "offer_name": {
          "type": "string"
        },
        "change_type": {
          "enum": [
            "new",
            "price_change",
            "limit_change",
            "provider_change",
            "end_date_change",
            "ended",
            "revived",
            "availability_change"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "required": [
        "name",
        "classification",
        "suspicion_score",
        "information_confidence",
        "operational_confidence",
        "ranking_eligible"
      ],
      "properties": {
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "FREE",
            "ULTRA_LOW",
            null
          ]
        },
        "model_vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery_type": {
          "enum": [
            "official",
            "reseller",
            "router",
            "product_internal",
            "unofficial",
            "unknown"
          ]
        },
        "classification": {
          "enum": [
            "A_TRUE_FREE",
            "B_PERMANENT_FREE_TIER",
            "C_LIMITED_FREE",
            "D_TRIAL_CREDIT",
            "E_DISCOUNT",
            "F_CONDITIONAL",
            "G_FREE_LIKE"
          ]
        },
        "start_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end_timezone_known": {
          "type": "boolean"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registration_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "card_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "minimum_deposit": {
          "type": [
            "number",
            "null"
          ]
        },
        "kyc_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "auto_renewal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "refund_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "free_limits": {
          "type": [
            "string",
            "null"
          ]
        },
        "rate_limits": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tool_calling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "structured_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "image_input": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "recent_activity": {
          "type": [
            "string",
            "null"
          ]
        },
        "normal_price_per_million": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "input": {
              "type": [
                "number",
                "null"
              ]
            },
            "output": {
              "type": [
                "number",
                "null"
              ]
            },
            "cache_read": {
              "type": [
                "number",
                "null"
              ]
            },
            "cache_write": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "effective_price_per_million": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "input",
            "output"
          ],
          "properties": {
            "input": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "type": "number",
              "minimum": 0
            },
            "cache_read": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "cache_write": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "effective_discount_percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "data_retention": {
          "type": [
            "string",
            "null"
          ]
        },
        "training_use": {
          "type": [
            "string",
            "null"
          ]
        },
        "suspicion_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "suspicion_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "information_confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "operational_confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "ranking_eligible": {
          "type": "boolean"
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "endpoint_source": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "free_allowance_rank": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "AMPLE",
            "NORMAL",
            "TIGHT",
            "TINY",
            null
          ]
        },
        "total_parameters_b": {
          "type": [
            "number",
            "null"
          ]
        },
        "active_parameters_b": {
          "type": [
            "number",
            "null"
          ]
        },
        "price_source": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "price_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "discount_start_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "discount_end_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "benchmark": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "score",
            "benchmark_name",
            "version",
            "tier"
          ],
          "properties": {
            "score": {
              "type": "number"
            },
            "benchmark_name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "tier": {
              "type": "string",
              "enum": [
                "S",
                "A",
                "B",
                null
              ]
            }
          }
        },
        "benchmark_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Internal key of the representative benchmark (terminal_bench_2_0 / terminal_bench_2_1) used by the shared ranking policy gate (spec 0004 AC-5)."
        },
        "benchmarks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "name",
              "score"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "body_excerpt": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "verified_at": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ranking_eligible": {
                "const": true
              }
            },
            "required": [
              "ranking_eligible"
            ]
          },
          "then": {
            "required": [
              "last_verified",
              "provider_key",
              "canonical_model_id",
              "access_kind",
              "effective_price_per_million",
              "price_source",
              "price_verified_at",
              "endpoint_source"
            ],
            "properties": {
              "last_verified": {
                "type": "string",
                "format": "date-time"
              },
              "provider_key": {
                "type": "string"
              },
              "canonical_model_id": {
                "type": "string"
              },
              "access_kind": {
                "enum": [
                  "FREE",
                  "ULTRA_LOW"
                ]
              },
              "price_source": {
                "type": "string",
                "format": "uri"
              },
              "price_verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "endpoint_source": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
