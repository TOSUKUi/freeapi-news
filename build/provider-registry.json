{
  "version": "candidate",
  "providers": [
    {
      "key": "nvidia",
      "label": "NVIDIA NIM",
      "match": [
        "nvidia",
        "nim",
        "integrate.api.nvidia.com"
      ],
      "base_url": "https://integrate.api.nvidia.com/v1",
      "base_url_pattern": "^https://integrate\\.api\\.nvidia\\.com/v1/?$",
      "openai_base_url": null,
      "api_type": "openai-completions",
      "delivery_type": "official",
      "env": "NVIDIA_API_KEY",
      "openai": true,
      "docs_url": "https://docs.api.nvidia.com/nim/reference/llm-apis",
      "agents": [
        "pi",
        "claude_code",
        "opencode",
        "codex"
      ],
      "notes": null,
      "added_at": "2026-07-28",
      "added_from": "https://docs.api.nvidia.com/nim/reference/llm-apis"
    },
    {
      "key": "openrouter",
      "label": "OpenRouter",
