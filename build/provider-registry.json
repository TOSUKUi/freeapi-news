    {
      "key": "cloudflare",
      "label": "Cloudflare Workers AI",
      "match": [
        "cloudflare",
        "workers ai"
      ],
      "base_url": "https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1",
      "base_url_pattern": "^https://api\\.cloudflare\\.com/client/v4/accounts/[^/]+/ai/v1/?$",
      "openai_base_url": null,
      "api_type": "openai-completions",
      "delivery_type": "official",
      "env": "CLOUDFLARE_API_TOKEN",
      "openai": true,
      "docs_url": "https://developers.cloudflare.com/workers-ai/configuration/open-ai-compatibility/",
      "agents": [
        "pi",
        "claude_code",
        "opencode",
        "codex"
      ],
      "notes": "OpenAI-compatible base is .../accounts/{ACCOUNT_ID}/ai/v1. The .../ai/run/@cf/... URL is the native Workers AI endpoint with a different request/response format — do not use it for OpenAI-style clients. Replace {ACCOUNT_ID} with your Cloudflare account ID; model IDs look like @cf/z-ai/glm-5.2.",
      "added_at": "2026-07-28",
      "added_from": "https://developers.cloudflare.com/workers-ai/configuration/open-ai-compatibility/"
    },
