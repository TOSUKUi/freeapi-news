      "openai_base_url": null,
      "api_type": "openai-completions",
      "delivery_type": "router",
      "env": "OPENROUTER_API_KEY",
      "openai": true,
      "docs_url": "https://openrouter.ai/docs/quickstart",
      "agents": [
        "pi",
        "claude_code",
        "opencode",
        "codex"
      ],
      "notes": "Free models use the ':free' suffix on the model ID.",
      "added_at": "2026-07-28",
      "added_from": "https://openrouter.ai/docs/quickstart",
      "model_page_template": "https://openrouter.ai/{model_id}",
      "api_catalog_url": "https://openrouter.ai/api/v1/models"
    },
